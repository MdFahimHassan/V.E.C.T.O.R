# Free Gemini key: https://aistudio.google.com/apikey  (free API tier is small, ~20 requests/day)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Free Groq key: https://console.groq.com/keys  (much bigger free allowance)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local model, no key needed: install Ollama, then `ollama pull qwen2.5:3b`
OLLAMA_MODEL=qwen2.5:3b

# Which brain to try first. Skipped automatically if it is down or out of quota.
BRAIN_ORDER=ollama,gemini,groq

WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
